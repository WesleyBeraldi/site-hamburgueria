PORT=3001
# Em produção, defina NODE_ENV=production e provisione o banco antes de iniciar.
# NODE_ENV=production

# MySQL Server usado pelo MySQL Workbench
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hamburgueria_app
DB_PASSWORD=defina-uma-senha-local-segura
DB_NAME=hamburgueria
DB_CONNECTION_LIMIT=10

ADMIN_USER=admin
ADMIN_EMAIL=admin@hamburgueria.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=troque-esta-senha

# Somente para ambientes descartáveis. Tokens são sempre gerados aleatoriamente.
# SEED_DEMO_DATA=1
# DEMO_WAITER_PIN=246810

# Caminho opcional. Por padrão, fica dentro da pasta server.
# UPLOADS_PATH=server/uploads
